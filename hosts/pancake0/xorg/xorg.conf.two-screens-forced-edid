# DRAFT 2026-11-12 (not installed, untested): two X screens on the one RTX A6000, projector forced on screen 1.
# Screen 0 = operator monitor (DP-0, managed by GNOME). Screen 1 = projector (DP-2), no window manager.
# Same as xorg.conf.two-screens (installed 2026-11-10) plus ConnectedMonitor and CustomEDID on Device1, so
# screen 1 claims DP-2 at 1920x1080 240 Hz even when the projector is off while X starts. Without them, X
# found no valid mode, started screen 1 empty, and GNOME later took the projector onto screen 0 (2026-11-12).
# Needs /etc/X11/benq-x3100i-dp2.edid.bin (hosts/pancake0/xorg/benq-x3100i-dp2.edid.bin).
# nvidia-settings: X configuration file generated by nvidia-settings
# nvidia-settings:  version 535.183.06

Section "ServerLayout"
    Identifier     "Layout0"
    Screen      0  "Screen0" 0 0
    Screen      1  "Screen1" RightOf "Screen0"
    InputDevice    "Keyboard0" "CoreKeyboard"
    InputDevice    "Mouse0" "CorePointer"
    Option         "Xinerama" "0"
EndSection

Section "Files"
EndSection

Section "InputDevice"
    Identifier     "Mouse0"
    Driver         "mouse"
    Option         "Protocol" "auto"
    Option         "Device" "/dev/psaux"
    Option         "Emulate3Buttons" "no"
    Option         "ZAxisMapping" "4 5"
EndSection

Section "InputDevice"
    Identifier     "Keyboard0"
    Driver         "kbd"
EndSection

# Dell U2723QE
Section "Monitor"
    Identifier     "Monitor0"
    VendorName     "DELL"
    ModelName      "U2723QE"
    HorizSync       15.0 - 140.0
    VertRefresh     23.0 - 86.0
    Option         "DPMS"
EndSection

# BenQ X3100i projector on DP-2 (active DP->HDMI 2.1 adapter), 1920x1080 at 240 Hz from EDID
Section "Monitor"
    Identifier     "BenQ-PJ"
    VendorName     "BenQ"
    ModelName      "Projector"
    # HDMI/CTA-style 1080p120 timing, exact 120.000 Hz, 297 MHz pixel clock
    Modeline "1920x1080_120.00" 297.00 1920 2008 2052 2200 1080 1084 1089 1125 +HSync +VSync
    Option "PreferredMode" "1920x1080_240"
EndSection

Section "Device"
    Identifier     "Device0"
    Driver         "nvidia"
    VendorName     "NVIDIA Corporation"
    BoardName      "NVIDIA RTX A6000"
    BusID          "PCI:1:0:0"
    Screen          0
    Option         "ExactModeTimingsDVI" "True"
    Option         "ModeValidation" "AllowNonEdidModes, NoEdidMaxPClkCheck, NoHorizSyncCheck, NoVertRefreshCheck"
    Option         "ModeDebug" "True"
EndSection

Section "Device"
    Identifier     "Device1"
    Driver         "nvidia"
    VendorName     "NVIDIA Corporation"
    BoardName      "NVIDIA RTX A6000"
    BusID          "PCI:1:0:0"
    Screen          1
    Option         "ConnectedMonitor" "DP-2"
    Option         "CustomEDID" "DP-2:/etc/X11/benq-x3100i-dp2.edid.bin"
    Option         "ExactModeTimingsDVI" "True"
    Option         "ModeValidation" "AllowNonEdidModes, NoEdidMaxPClkCheck, NoHorizSyncCheck, NoVertRefreshCheck"
    Option         "ModeDebug" "True"
EndSection

Section "Screen"
    Identifier     "Screen0"
    Device         "Device0"
    Monitor        "Monitor0"
    DefaultDepth    24
    Option         "Stereo" "0"
    Option         "nvidiaXineramaInfoOrder" "DP-0"
    Option         "metamodes" "DP-0: nvidia-auto-select +0+0"
    Option         "SLI" "Off"
    Option         "MultiGPU" "Off"
    Option         "BaseMosaic" "off"
    SubSection     "Display"
        Depth       24
    EndSubSection
EndSection

Section "Screen"
    Identifier     "Screen1"
    Device         "Device1"
    Monitor        "BenQ-PJ"
    DefaultDepth    24
    Option         "Stereo" "0"
    Option         "metamodes" "DP-2: 1920x1080_240 +0+0"
    SubSection     "Display"
        Depth       24
    EndSubSection
EndSection
