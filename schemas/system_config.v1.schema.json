{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/system_config.v1.schema.json",
  "title": "system_config v1",
  "description": "Machine inventory and network/camera assignment schema for Pancake/Orange hosts.",
  "type": "object",
  "required": [
    "schema",
    "system_info",
    "nics",
    "cameras"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "system_config"
        },
        "version": {
          "const": 1
        }
      }
    },
    "system_info": {
      "type": "object",
      "required": [
        "hostname",
        "network_renderer"
      ],
      "additionalProperties": true,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "network_renderer": {
          "const": "NetworkManager"
        },
        "network_renderer_version": {
          "type": "string"
        }
      }
    },
    "nics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "$ref": "#/$defs/nic"
        }
      }
    },
    "cameras": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      }
    },
    "kernel_tuning": {
      "type": "object",
      "description": "Kernel-side tuning the acquisition pipeline depends on; recorded and verified by check_kernel_tuning.py (docs/kernel_tuning.md).",
      "additionalProperties": true,
      "properties": {
        "cmdline": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "Kernel command-line options that must be present (isolcpus, nohz_full, rcu_nocbs, tsc, iommu)."
        },
        "isolated_cores": {
          "$ref": "#/$defs/cpuList"
        },
        "core_roles": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[0-9]+$": {
              "$ref": "#/$defs/coreRole"
            }
          },
          "description": "Purpose of each isolated CPU, keyed by CPU number (as a string)."
        },
        "sysctl_file": {
          "type": "string"
        },
        "sysctl": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "transparent_hugepage": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "camera_ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mtu": {
                "type": "integer"
              },
              "mlx5_irq_cpus": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Machine-level paths other programs need. Values may embed a username until the shared-machine migration moves data to shared storage; recording them here is still the one place to change.",
      "properties": {
        "data_root": {
          "type": "string",
          "description": "Root of recorded data and runtime camera presets (orange_data)."
        },
        "orange_run_dir": {
          "type": "string",
          "description": "Orange's runtime state directory (latest_recording.json etc.)."
        },
        "shared_config_root": {
          "type": "string",
          "description": "Where machine-level configuration lives (default /etc/pancakebatter)."
        }
      }
    },
    "pdus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "outlets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "camera_serial": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Camera on this outlet (preferred over parsing 'SN:' out of description)."
                }
              }
            }
          }
        }
      }
    },
    "storage_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "macAddress": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "nicRole": {
      "type": "string",
      "enum": [
        "camera",
        "spare",
        "management",
        "uplink",
        "unknown"
      ]
    },
    "nic": {
      "type": "object",
      "required": [
        "altname",
        "role",
        "managed",
        "expected_link",
        "mac_address",
        "mtu",
        "ip_address",
        "link_settings"
      ],
      "additionalProperties": true,
      "properties": {
        "altname": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/nicRole"
        },
        "managed": {
          "type": "boolean"
        },
        "expected_link": {
          "type": "boolean"
        },
        "mac_address": {
          "$ref": "#/$defs/macAddress"
        },
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "part_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "pcie_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial_number": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "mtu": {
          "type": "integer",
          "minimum": 68
        },
        "ip_address": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "link_settings": {
          "type": "object",
          "required": [
            "speed",
            "autoneg"
          ],
          "additionalProperties": true,
          "properties": {
            "speed": {
              "type": "integer",
              "minimum": 1
            },
            "autoneg": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "serial_number",
        "ip_address",
        "nic_port"
      ],
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial_number": {
          "type": [
            "string",
            "integer"
          ]
        },
        "ip_address": {
          "type": "string",
          "format": "ipv4"
        },
        "nic_port": {
          "type": "string",
          "minLength": 1
        },
        "sensor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "x_resolution": {
              "type": "integer",
              "minimum": 1,
              "description": "Sensor width in pixels (promised stable key)."
            },
            "y_resolution": {
              "type": "integer",
              "minimum": 1,
              "description": "Sensor height in pixels (promised stable key)."
            }
          },
          "description": "Sensor facts; only x_resolution and y_resolution are promised stable keys, the rest is inventory."
        }
      }
    },
    "cpuList": {
      "type": "string",
      "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$",
      "description": "Kernel cpulist, e.g. \"1,2,6-8\"."
    },
    "coreRole": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "acquisition",
            "yolo",
            "stimulus_render",
            "arena_update",
            "smt_sibling",
            "housekeeping",
            "other",
            "unassigned"
          ],
          "description": "What runs on this isolated CPU. smt_sibling = the other hyperthread of a core whose role is recorded on its sibling, kept idle. unassigned = isolated with no consumer (reported as a warning)."
        },
        "consumer": {
          "type": "string",
          "description": "Program that pins to this CPU, e.g. orange."
        },
        "camera": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Camera serial this CPU serves, when per camera."
        },
        "sibling_of": {
          "type": "integer",
          "minimum": 0,
          "description": "For smt_sibling: the CPU whose physical core this is."
        },
        "note": {
          "type": "string"
        },
        "thread": {
          "type": "string",
          "description": "Thread or entry point that runs here, e.g. StimulusDisplayManager::Run."
        }
      }
    }
  }
}
