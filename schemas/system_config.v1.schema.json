{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/system_config.v1.schema.json",
  "title": "system_config v1",
  "description": "Machine inventory and network/camera assignment schema for Pancake/Orange hosts.",
  "type": "object",
  "required": [
    "schema",
    "system_info",
    "nics",
    "cameras"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "system_config"
        },
        "version": {
          "const": 1
        }
      }
    },
    "system_info": {
      "type": "object",
      "required": [
        "hostname",
        "network_renderer"
      ],
      "additionalProperties": true,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "network_renderer": {
          "const": "NetworkManager"
        },
        "network_renderer_version": {
          "type": "string"
        }
      }
    },
    "nics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "$ref": "#/$defs/nic"
        }
      }
    },
    "cameras": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      }
    },
    "kernel_tuning": {
      "type": "object",
      "description": "Kernel-side tuning the acquisition pipeline depends on; recorded and verified by check_kernel_tuning.py (docs/kernel_tuning.md).",
      "additionalProperties": true,
      "properties": {
        "cmdline": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "Kernel command-line options that must be present (isolcpus, nohz_full, rcu_nocbs, tsc, iommu)."
        },
        "isolated_cores": {
          "$ref": "#/$defs/cpuList"
        },
        "core_roles": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[0-9]+$": {
              "$ref": "#/$defs/coreRole"
            }
          },
          "description": "Purpose of each isolated CPU, keyed by CPU number (as a string)."
        },
        "sysctl_file": {
          "type": "string"
        },
        "sysctl": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "transparent_hugepage": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "camera_ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mtu": {
                "type": "integer"
              },
              "mlx5_irq_cpus": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Machine-level paths other programs need. Values may embed a username until the shared-machine migration moves data to shared storage; recording them here is still the one place to change.",
      "properties": {
        "data_root": {
          "type": "string",
          "description": "Root of recorded data and runtime camera presets (orange_data)."
        },
        "orange_run_dir": {
          "type": "string",
          "description": "Orange's runtime state directory (latest_recording.json etc.)."
        },
        "shared_config_root": {
          "type": "string",
          "description": "Where machine-level configuration lives (default /etc/pancakebatter)."
        },
        "recording_transfer_root": {
          "type": "string",
          "description": "Root of the per-version recording-transfer sealer installs: <root>/<version>/bin/<script>, INSTALLED.json."
        }
      }
    },
    "pdus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "outlets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "camera_serial": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Camera on this outlet (preferred over parsing 'SN:' out of description)."
                }
              }
            }
          }
        }
      }
    },
    "storage_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pcie_topology": {
      "type": "object",
      "additionalProperties": true,
      "description": "PCIe host bridges and the leaf devices below each (pcie_topology.py --record).",
      "properties": {
        "host_bridges": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "note": {
                "type": "string"
              },
              "devices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pci",
                    "kind"
                  ],
                  "properties": {
                    "pci": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
                    },
                    "kind": {
                      "enum": [
                        "gpu",
                        "nic",
                        "nvme",
                        "other"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "mounts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "serial": {
                      "type": "string",
                      "description": "Controller serial (NVMe): the stable identity of a drive; nvmeN is not."
                    },
                    "partitions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uuid": {
                            "type": "string"
                          },
                          "mounts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "system_python": {
      "type": "object",
      "description": "What /usr/bin/python3 has, captured by capture_inventory.py (--refresh --only system_python after changes). Internal: not a stable key.",
      "required": [
        "executable",
        "version",
        "apt_manifest",
        "pip_installed"
      ],
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apt_manifest": {
          "type": "object",
          "description": "packages/apt/python.txt -> installed apt version, null when missing.",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "pip_installed": {
          "type": "object",
          "description": "Distributions outside apt's /usr/lib/python3/dist-packages, by directory (/usr/local and the capturing user's site-packages) -> {name: version}. Empty when pip has put nothing there.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "daqs": {
      "type": "array",
      "description": "Data acquisition devices on this host and what is wired to each channel (docs/host_config_interface.md#instruments).",
      "items": {
        "$ref": "#/$defs/daq"
      }
    },
    "photodetectors": {
      "type": "array",
      "description": "Photodetectors on this host: the fitted filter, the DAQ channel they feed, and their calibration.",
      "items": {
        "$ref": "#/$defs/photodetector"
      }
    },
    "light_arrays": {
      "type": "array",
      "description": "Illumination arrays powered from a PDU outlet, and what strobes them.",
      "items": {
        "$ref": "#/$defs/lightArray"
      }
    }
  },
  "$defs": {
    "macAddress": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "nicRole": {
      "type": "string",
      "enum": [
        "camera",
        "spare",
        "management",
        "uplink",
        "unknown"
      ]
    },
    "nic": {
      "type": "object",
      "required": [
        "altname",
        "role",
        "managed",
        "expected_link",
        "mac_address",
        "mtu",
        "ip_address",
        "link_settings"
      ],
      "additionalProperties": true,
      "properties": {
        "altname": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/nicRole"
        },
        "managed": {
          "type": "boolean"
        },
        "expected_link": {
          "type": "boolean"
        },
        "mac_address": {
          "$ref": "#/$defs/macAddress"
        },
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "part_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "pcie_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial_number": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "mtu": {
          "type": "integer",
          "minimum": 68
        },
        "ip_address": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "link_settings": {
          "type": "object",
          "required": [
            "speed",
            "autoneg"
          ],
          "additionalProperties": true,
          "properties": {
            "speed": {
              "type": "integer",
              "minimum": 1
            },
            "autoneg": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "serial_number",
        "ip_address",
        "nic_port"
      ],
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial_number": {
          "type": [
            "string",
            "integer"
          ]
        },
        "ip_address": {
          "type": "string",
          "format": "ipv4"
        },
        "nic_port": {
          "type": "string",
          "minLength": 1
        },
        "sensor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "x_resolution": {
              "type": "integer",
              "minimum": 1,
              "description": "Sensor width in pixels (promised stable key)."
            },
            "y_resolution": {
              "type": "integer",
              "minimum": 1,
              "description": "Sensor height in pixels (promised stable key)."
            }
          },
          "description": "Sensor facts; only x_resolution and y_resolution are promised stable keys, the rest is inventory."
        },
        "part_id": {
          "type": "string",
          "pattern": "^camera\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "description": "Optional link to the camera's part design in hardware_library (parts/cameras/<part_id>/part.yml): CAD, datum frame, dimensions. This entry is the instance (serial, MAC, host)."
        },
        "lens": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "part_id": {
              "type": "string",
              "pattern": "^lens\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
              "description": "Optional link to the lens's part design in hardware_library (parts/lenses/<part_id>/part.yml)."
            }
          }
        }
      }
    },
    "cpuList": {
      "type": "string",
      "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$",
      "description": "Kernel cpulist, e.g. \"1,2,6-8\"."
    },
    "coreRole": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "acquisition",
            "yolo",
            "stimulus_render",
            "arena_update",
            "smt_sibling",
            "housekeeping",
            "other",
            "unassigned"
          ],
          "description": "What runs on this isolated CPU. smt_sibling = the other hyperthread of a core whose role is recorded on its sibling, kept idle. unassigned = isolated with no consumer (reported as a warning)."
        },
        "consumer": {
          "type": "string",
          "description": "Program that pins to this CPU, e.g. orange."
        },
        "camera": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Camera serial this CPU serves, when per camera."
        },
        "sibling_of": {
          "type": "integer",
          "minimum": 0,
          "description": "For smt_sibling: the CPU whose physical core this is."
        },
        "note": {
          "type": "string"
        },
        "thread": {
          "type": "string",
          "description": "Thread or entry point that runs here, e.g. StimulusDisplayManager::Run."
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date, quoted in YAML (an unquoted 2026-10-19 loads as a date object, not a string)."
    },
    "serialNumber": {
      "type": [
        "string",
        "integer"
      ]
    },
    "calibration": {
      "type": "object",
      "required": [
        "calibrated_at",
        "due",
        "performed_by"
      ],
      "additionalProperties": true,
      "properties": {
        "certificate_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Certificate or report id; null for an in-house calibration without one."
        },
        "calibrated_at": {
          "$ref": "#/$defs/date"
        },
        "due": {
          "$ref": "#/$defs/date",
          "description": "Recalibration due date; a past date is reported as a warning."
        },
        "performed_by": {
          "type": "string",
          "minLength": 1
        },
        "filter": {
          "$ref": "#/$defs/filterRef",
          "description": "Photodetectors: the filter fitted when calibrated. A different fitted filter invalidates the calibration."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "filterRef": {
      "description": "A fitted filter, or the string none for an explicit bare detector.",
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "required": [
            "part_id",
            "serial_or_lot"
          ],
          "additionalProperties": true,
          "properties": {
            "part_id": {
              "type": "string",
              "pattern": "^filter\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
              "description": "The filter's part design in hardware_library (category filter)."
            },
            "serial_or_lot": {
              "type": [
                "string",
                "null"
              ],
              "description": "Serial or lot of the filter; null when the vendor gives neither."
            },
            "fitted_at": {
              "$ref": "#/$defs/date"
            }
          }
        }
      ]
    },
    "daqChannelRef": {
      "type": "object",
      "required": [
        "daq",
        "channel"
      ],
      "additionalProperties": false,
      "properties": {
        "daq": {
          "type": "string",
          "minLength": 1,
          "description": "daqs.*.name on this host."
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "description": "daqs.*.channels.*.id of that DAQ."
        }
      }
    },
    "sharedId": {
      "type": "string",
      "minLength": 1,
      "description": "id of an item in equipment/shared.yml. The item supplies part_id, serial_number and calibration, so the instance must not repeat them."
    },
    "daqChannelSource": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "enum": [
            "camera_gpio",
            "photodetector",
            "light_array",
            "host",
            "other"
          ],
          "description": "camera_gpio = a camera GPIO line (camera_serial, gpio_line); photodetector / light_array = by name on this host; host = the computer itself; other = see note."
        },
        "camera_serial": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "gpio_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Camera GPIO line; null until confirmed."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "camera_gpio"
              }
            }
          },
          "then": {
            "required": [
              "camera_serial",
              "gpio_line"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "photodetector",
                  "light_array"
                ]
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "other"
              }
            }
          },
          "then": {
            "required": [
              "note"
            ]
          }
        }
      ]
    },
    "daqChannel": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "kind",
        "signal",
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Channel as the device labels it, e.g. AI0, DIO3, CTR0."
        },
        "direction": {
          "enum": [
            "in",
            "out"
          ]
        },
        "kind": {
          "enum": [
            "analog",
            "digital",
            "counter"
          ]
        },
        "signal": {
          "type": "string",
          "minLength": 1,
          "description": "What the channel carries, e.g. cam2010096_exposure."
        },
        "source": {
          "$ref": "#/$defs/daqChannelSource"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "daq": {
      "type": "object",
      "required": [
        "name",
        "channels"
      ],
      "anyOf": [
        {
          "required": [
            "serial_number"
          ]
        },
        {
          "required": [
            "shared_id"
          ]
        }
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shared_id": {
          "$ref": "#/$defs/sharedId"
        },
        "part_id": {
          "type": "string",
          "pattern": "^daq\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "description": "Optional link to the DAQ's part design in hardware_library (parts/daqs/<part_id>/part.yml). Omitted while unknown."
        },
        "serial_number": {
          "$ref": "#/$defs/serialNumber"
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Driver or library, e.g. uldaq."
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/daqChannel"
          }
        },
        "calibration": {
          "$ref": "#/$defs/calibration"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "photodetector": {
      "type": "object",
      "required": [
        "name"
      ],
      "anyOf": [
        {
          "required": [
            "serial_number"
          ]
        },
        {
          "required": [
            "shared_id"
          ]
        }
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shared_id": {
          "$ref": "#/$defs/sharedId"
        },
        "part_id": {
          "type": "string",
          "pattern": "^photodetector\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "description": "Optional link to the photodetector's part design in hardware_library (parts/photodetectors/<part_id>/part.yml). Omitted while unknown."
        },
        "serial_number": {
          "$ref": "#/$defs/serialNumber"
        },
        "settings": {
          "type": "object",
          "additionalProperties": true,
          "description": "Front-panel settings for parts that have them, e.g. gain_db: 40."
        },
        "filter": {
          "$ref": "#/$defs/filterRef"
        },
        "daq_channel": {
          "$ref": "#/$defs/daqChannelRef"
        },
        "calibration": {
          "allOf": [
            {
              "$ref": "#/$defs/calibration"
            },
            {
              "required": [
                "filter"
              ]
            }
          ],
          "description": "Must record the filter fitted at calibration; it is compared with the fitted filter."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "lightArray": {
      "type": "object",
      "required": [
        "name",
        "pdu",
        "outlet",
        "wavelength_nm",
        "strobe"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal the name of the PDU outlet that powers it."
        },
        "pdu": {
          "type": "string",
          "minLength": 1,
          "description": "pdus.*.name."
        },
        "outlet": {
          "type": [
            "integer",
            "string"
          ],
          "description": "Key of that PDU's outlets map."
        },
        "part_id": {
          "type": "string",
          "pattern": "^light_source\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "description": "Optional link to the array's part design in hardware_library (category light_source). Omitted while unknown."
        },
        "wavelength_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "driver": {
          "type": [
            "string",
            "null"
          ],
          "description": "Driver electronics, free text; null until known."
        },
        "strobe": {
          "$ref": "#/$defs/strobe"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "strobe": {
      "type": "object",
      "required": [
        "source"
      ],
      "additionalProperties": true,
      "properties": {
        "source": {
          "enum": [
            "camera_gpio",
            "daq",
            "none",
            "unknown"
          ],
          "description": "camera_gpio = a camera GPIO line (camera_serial, gpio_line); daq = a DAQ output (daq_channel); none = always on when powered; unknown = not recorded yet."
        },
        "camera_serial": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "gpio_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Camera GPIO line; null until confirmed."
        },
        "daq_channel": {
          "$ref": "#/$defs/daqChannelRef"
        },
        "via": {
          "enum": [
            "direct",
            "driver_board",
            "unknown"
          ],
          "description": "Whether the line reaches the array directly or through a driver board."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "camera_gpio"
              }
            }
          },
          "then": {
            "required": [
              "camera_serial",
              "gpio_line",
              "via"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "daq"
              }
            }
          },
          "then": {
            "required": [
              "daq_channel",
              "via"
            ]
          }
        }
      ]
    }
  }
}
