{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/system_config.v1.schema.json",
  "title": "system_config v1",
  "description": "Machine inventory and network/camera assignment schema for Pancake/Orange hosts.",
  "type": "object",
  "required": ["schema", "system_info", "nics", "cameras"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "system_config"
        },
        "version": {
          "const": 1
        }
      }
    },
    "system_info": {
      "type": "object",
      "required": ["hostname", "network_renderer"],
      "additionalProperties": true,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "network_renderer": {
          "const": "NetworkManager"
        },
        "network_renderer_version": {
          "type": "string"
        }
      }
    },
    "nics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "$ref": "#/$defs/nic"
        }
      }
    },
    "cameras": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      }
    }
  },
  "$defs": {
    "macAddress": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "nicRole": {
      "type": "string",
      "enum": ["camera", "spare", "management", "uplink", "unknown"]
    },
    "nic": {
      "type": "object",
      "required": [
        "altname",
        "role",
        "managed",
        "expected_link",
        "mac_address",
        "mtu",
        "ip_address",
        "link_settings"
      ],
      "additionalProperties": true,
      "properties": {
        "altname": {
          "type": ["string", "null"]
        },
        "role": {
          "$ref": "#/$defs/nicRole"
        },
        "managed": {
          "type": "boolean"
        },
        "expected_link": {
          "type": "boolean"
        },
        "mac_address": {
          "$ref": "#/$defs/macAddress"
        },
        "brand": {
          "type": ["string", "null"]
        },
        "model": {
          "type": ["string", "null"]
        },
        "part_number": {
          "type": ["string", "null"]
        },
        "pcie_id": {
          "type": ["string", "null"]
        },
        "serial_number": {
          "type": ["string", "integer", "null"]
        },
        "mtu": {
          "type": "integer",
          "minimum": 68
        },
        "ip_address": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "link_settings": {
          "type": "object",
          "required": ["speed", "autoneg"],
          "additionalProperties": true,
          "properties": {
            "speed": {
              "type": "integer",
              "minimum": 1
            },
            "autoneg": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": ["serial_number", "ip_address", "nic_port"],
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": ["string", "null"]
        },
        "serial_number": {
          "type": ["string", "integer"]
        },
        "ip_address": {
          "type": "string",
          "format": "ipv4"
        },
        "nic_port": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
