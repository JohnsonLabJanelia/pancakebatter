{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/system_config.v1.schema.json",
  "title": "system_config v1",
  "description": "Machine inventory and network/camera assignment schema for Pancake/Orange hosts.",
  "type": "object",
  "required": [
    "schema",
    "system_info",
    "nics",
    "cameras"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "system_config"
        },
        "version": {
          "const": 1
        }
      }
    },
    "system_info": {
      "type": "object",
      "required": [
        "hostname",
        "network_renderer"
      ],
      "additionalProperties": true,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "network_renderer": {
          "const": "NetworkManager"
        },
        "network_renderer_version": {
          "type": "string"
        }
      }
    },
    "nics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": {
          "$ref": "#/$defs/nic"
        }
      }
    },
    "cameras": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      }
    },
    "kernel_tuning": {
      "type": "object",
      "description": "Kernel-side tuning the acquisition pipeline depends on; recorded and verified by check_kernel_tuning.py (docs/kernel_tuning.md).",
      "additionalProperties": true,
      "properties": {
        "cmdline": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          },
          "description": "Kernel command-line options that must be present (isolcpus, nohz_full, rcu_nocbs, tsc, iommu)."
        },
        "isolated_cores": {
          "$ref": "#/$defs/cpuList"
        },
        "core_roles": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[0-9]+$": {
              "$ref": "#/$defs/coreRole"
            }
          },
          "description": "Purpose of each isolated CPU, keyed by CPU number (as a string)."
        },
        "sysctl_file": {
          "type": "string"
        },
        "sysctl": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "transparent_hugepage": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "camera_ports": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mtu": {
                "type": "integer"
              },
              "mlx5_irq_cpus": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Machine-level paths other programs need. Values may embed a username until the shared-machine migration moves data to shared storage; recording them here is still the one place to change.",
      "properties": {
        "data_root": {
          "type": "string",
          "description": "Root of recorded data and runtime camera presets (orange_data)."
        },
        "orange_run_dir": {
          "type": "string",
          "description": "Orange's runtime state directory (latest_recording.json etc.)."
        },
        "shared_config_root": {
          "type": "string",
          "description": "Where machine-level configuration lives (default /etc/pancakebatter)."
        },
        "recording_transfer_root": {
          "type": "string",
          "description": "Root of the per-version recording-transfer sealer installs: <root>/<version>/bin/<script>, INSTALLED.json."
        }
      }
    },
    "pdus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "outlets": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "camera_serial": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Camera on this outlet (preferred over parsing 'SN:' out of description)."
                }
              }
            }
          }
        }
      }
    },
    "storage_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gpus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "pcie_topology": {
      "type": "object",
      "additionalProperties": true,
      "description": "PCIe host bridges and the leaf devices below each (pcie_topology.py --record).",
      "properties": {
        "host_bridges": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "note": {
                "type": "string"
              },
              "devices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pci",
                    "kind"
                  ],
                  "properties": {
                    "pci": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
                    },
                    "kind": {
                      "enum": [
                        "gpu",
                        "nic",
                        "nvme",
                        "other"
                      ]
                    },
                    "name": {
                      "type": "string"
                    },
                    "mounts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "serial": {
                      "type": "string",
                      "description": "Controller serial (NVMe): the stable identity of a drive; nvmeN is not."
                    },
                    "partitions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uuid": {
                            "type": "string"
                          },
                          "mounts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "system_python": {
      "type": "object",
      "description": "What /usr/bin/python3 has, captured by capture_inventory.py (--refresh --only system_python after changes). Internal: not a stable key.",
      "required": [
        "executable",
        "version",
        "apt_manifest",
        "pip_installed"
      ],
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "apt_manifest": {
          "type": "object",
          "description": "packages/apt/python.txt -> installed apt version, null when missing.",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "pip_installed": {
          "type": "object",
          "description": "Distributions outside apt's /usr/lib/python3/dist-packages, by directory (/usr/local and the capturing user's site-packages) -> {name: version}. Empty when pip has put nothing there.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "rigs": {
      "type": "array",
      "description": "Rigs this host drives (rigs/<rig_id>/rig.yml) and which display output drives each projection path. Ids and host-side hardware only; physical layout lives in the rig document. Optional section.",
      "items": {
        "type": "object",
        "required": [
          "rig_id",
          "display_outputs"
        ],
        "additionalProperties": false,
        "properties": {
          "rig_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "display_outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "output_name",
                "projection_path"
              ],
              "additionalProperties": false,
              "properties": {
                "output_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "xrandr output name (e.g. DP-3)."
                },
                "projection_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Key in the rig document's projection_paths."
                },
                "projector": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "manufacturer": {
                      "type": "string"
                    },
                    "model": {
                      "type": "string"
                    },
                    "serial_number": {
                      "type": [
                        "string",
                        "integer",
                        "null"
                      ]
                    },
                    "firmware_version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "part_id": {
                      "type": "string",
                      "pattern": "^projector\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
                      "description": "Optional link to the projector's part design in hardware_library (parts/projectors/<part_id>/part.yml)."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "macAddress": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$"
    },
    "nicRole": {
      "type": "string",
      "enum": [
        "camera",
        "spare",
        "management",
        "uplink",
        "unknown"
      ]
    },
    "nic": {
      "type": "object",
      "required": [
        "altname",
        "role",
        "managed",
        "expected_link",
        "mac_address",
        "mtu",
        "ip_address",
        "link_settings"
      ],
      "additionalProperties": true,
      "properties": {
        "altname": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/nicRole"
        },
        "managed": {
          "type": "boolean"
        },
        "expected_link": {
          "type": "boolean"
        },
        "mac_address": {
          "$ref": "#/$defs/macAddress"
        },
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "part_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "pcie_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial_number": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "mtu": {
          "type": "integer",
          "minimum": 68
        },
        "ip_address": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "link_settings": {
          "type": "object",
          "required": [
            "speed",
            "autoneg"
          ],
          "additionalProperties": true,
          "properties": {
            "speed": {
              "type": "integer",
              "minimum": 1
            },
            "autoneg": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "serial_number",
        "ip_address",
        "nic_port"
      ],
      "additionalProperties": true,
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "serial_number": {
          "type": [
            "string",
            "integer"
          ]
        },
        "ip_address": {
          "type": "string",
          "format": "ipv4"
        },
        "nic_port": {
          "type": "string",
          "minLength": 1
        },
        "sensor": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "x_resolution": {
              "type": "integer",
              "minimum": 1,
              "description": "Sensor width in pixels (promised stable key)."
            },
            "y_resolution": {
              "type": "integer",
              "minimum": 1,
              "description": "Sensor height in pixels (promised stable key)."
            }
          },
          "description": "Sensor facts; only x_resolution and y_resolution are promised stable keys, the rest is inventory."
        },
        "part_id": {
          "type": "string",
          "pattern": "^camera\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "description": "Optional link to the camera's part design in hardware_library (parts/cameras/<part_id>/part.yml): CAD, datum frame, dimensions. This entry is the instance (serial, MAC, host)."
        },
        "lens": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "part_id": {
              "type": "string",
              "pattern": "^lens\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$",
              "description": "Optional link to the lens's part design in hardware_library (parts/lenses/<part_id>/part.yml)."
            }
          }
        },
        "genicam": {
          "type": "object",
          "additionalProperties": true,
          "description": "The camera's GenICam XML as captured (optional). xml_sha256 uses Orange's 'sha256:<hex>' form so it compares directly with the sensor_pipeline.genicam_xml.sha256 Orange seals per recording. nodes_present/nodes_absent list the geometry-relevant feature nodes checked, so 'cannot flip' (ReverseX absent) is a recorded fact.",
          "required": [
            "xml_sha256",
            "captured_at",
            "nodes_present",
            "nodes_absent"
          ],
          "properties": {
            "xml_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1
            },
            "captured_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "evidence_path": {
              "type": "string"
            },
            "device_firmware": {
              "type": "string"
            },
            "nodes_present": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nodes_absent": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cpuList": {
      "type": "string",
      "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$",
      "description": "Kernel cpulist, e.g. \"1,2,6-8\"."
    },
    "coreRole": {
      "type": "object",
      "required": [
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "acquisition",
            "yolo",
            "stimulus_render",
            "arena_update",
            "smt_sibling",
            "housekeeping",
            "other",
            "unassigned"
          ],
          "description": "What runs on this isolated CPU. smt_sibling = the other hyperthread of a core whose role is recorded on its sibling, kept idle. unassigned = isolated with no consumer (reported as a warning)."
        },
        "consumer": {
          "type": "string",
          "description": "Program that pins to this CPU, e.g. orange."
        },
        "camera": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Camera serial this CPU serves, when per camera."
        },
        "sibling_of": {
          "type": "integer",
          "minimum": 0,
          "description": "For smt_sibling: the CPU whose physical core this is."
        },
        "note": {
          "type": "string"
        },
        "thread": {
          "type": "string",
          "description": "Thread or entry point that runs here, e.g. StimulusDisplayManager::Run."
        }
      }
    }
  }
}
